# chatops-bot/.env — copy từ .env gốc hoặc điền thủ công
# KHÔNG commit file này

# Slack credentials
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# LLM Provider — gemini (default, dùng chung GEMINI_API_KEY từ .env gốc)
CHATOPS_LLM_PROVIDER=gemini  # gemini | deepseek | anthropic

# API Keys — dùng chung từ .env gốc (GEMINI_API_KEY)
# Nếu cần riêng:
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# Model override (optional)
# GEMINI_CHAT_MODEL=gemini-3-flash-preview
# DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

# Backend services
INSIGHTHUB_API_URL=http://localhost:8000
PROMETHEUS_URL=http://localhost:9090
K8S_NAMESPACE=insighthub-dev
LOG_LEVEL=INFO

# Audit log path
CHATOPS_AUDIT_LOG=chatops-audit.log
