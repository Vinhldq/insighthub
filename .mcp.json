{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.1.14",
        "C:/Study/DevOps/insighthubTest1"
      ],
      "env": {}
    },
    "docker": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run"
      ],
      "env": {}
    },
    "kubernetes": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@0.0.62",
        "--read-only"
      ],
      "env": {}
    },
    "prometheus": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@wkronmiller/prometheus-mcp-server@2.0.0",
        "--endpoint",
        "http://localhost:9090"
      ],
      "env": {}
    },
    "aws": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@1.3.38"
      ],
      "env": {}
    }
  }
}